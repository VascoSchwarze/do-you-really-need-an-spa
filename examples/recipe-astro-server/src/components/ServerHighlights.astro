---
import { getCollection } from "astro:content";
import { recordView, rankByViews, getRating } from "../server/recipe-stats";
import { useTranslations, localizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

type Props = {
	lang: Lang;
	currentSlug: string;
};

const { lang, currentSlug } = Astro.props;
const t = useTranslations(lang);

const views = recordView(currentSlug);
const rating = getRating(currentSlug);

const allRecipes = await getCollection("recipes");
const trending = rankByViews(allRecipes.map((r) => ({ slug: r.id, title: r.data.title[lang] })))
	.filter((r) => r.slug !== currentSlug && r.views > 0)
	.slice(0, 3);

const renderedAt = new Date();
---

<aside class="server-highlights" aria-labelledby="server-highlights-heading">
	<p class="badge">{t("server.badge")}</p>
	<h2 id="server-highlights-heading">{t("server.heading")}</h2>
	<p class="hint">{t("server.hint")}</p>

	<div class="stat-row">
		<div class="stat">
			<span class="stat-value">{views}</span>
			<span class="stat-label">{t("server.views")}</span>
		</div>
		<div class="stat">
			<span class="stat-value">{rating.count > 0 ? rating.average.toFixed(1) : "–"}</span>
			<span class="stat-label">
				{rating.count > 0 ? `${rating.count} ${t("server.ratings")}` : t("server.noRatings")}
			</span>
		</div>
	</div>

	{
		trending.length > 0 && (
			<div class="trending">
				<h3>{t("server.mostViewed")}</h3>
				<ol>
					{trending.map((r) => (
						<li>
							<a href={localizedPath(lang, "recipes", r.slug)}>{r.title}</a>
							<span class="views">
								{r.views} {t("server.views")}
							</span>
						</li>
					))}
				</ol>
			</div>
		)
	}

	<p class="timestamp">
		{t("server.renderedAt")}
		{renderedAt.toLocaleTimeString(lang === "de" ? "de-DE" : "en-US")}
	</p>
</aside>

<style>
	.server-highlights {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.25rem 1.5rem;
		margin-bottom: 2.5rem;
	}

	.badge {
		display: inline-block;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 700;
		color: var(--color-primary-dark);
		background: color-mix(in srgb, var(--color-primary) 12%, transparent);
		padding: 0.2rem 0.5rem;
		border-radius: var(--radius);
		margin: 0 0 0.5rem;
	}

	.server-highlights h2 {
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}

	.hint {
		color: var(--color-muted);
		font-size: 0.8rem;
		margin-bottom: 1rem;
	}

	.stat-row {
		display: flex;
		gap: 2rem;
		margin-bottom: 1rem;
	}

	.stat-value {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.75rem;
		line-height: 1;
	}

	.stat-label {
		display: block;
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-top: 0.25rem;
	}

	.trending h3 {
		font-size: 0.9rem;
		margin-bottom: 0.5rem;
	}

	.trending ol {
		list-style: decimal;
		padding-left: 1.25rem;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.trending .views {
		color: var(--color-muted);
		font-size: 0.8rem;
		margin-left: 0.4rem;
	}

	.timestamp {
		margin: 1rem 0 0;
		font-size: 0.75rem;
		color: var(--color-muted);
	}
</style>
