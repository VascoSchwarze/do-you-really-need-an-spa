---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

type Props = {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="page">
  <h1>{t('about.title')}</h1>
  <p>{t('about.p1')}</p>
  <p>{t('about.p2')}</p>
  <p>{t('about.p3')}</p>
</div>

<style>
  .page {
    max-width: 640px;
  }

  .page h1 {
    margin-bottom: 1rem;
  }
</style>
